# Copy to .env.local and fill in. See docs/SETUP-KEYS.md for how to obtain each value.

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://roarrealty.in
# Live by default. Set to `preview` only to pull the site out of search.
# NEXT_PUBLIC_SITE_MODE=preview

# ---- Sanity (CMS) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# ---- Neon Postgres (private lead database) ----
DATABASE_URL=

# ---- Resend (lead email) ----
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=

# ---- Admin ----
LEADS_ADMIN_PASSWORD=

# ---- Cloudflare Turnstile (optional; blank = honeypot + rate limit only) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Business details (public) ----
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_RERA_NUMBER=
